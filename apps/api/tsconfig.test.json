{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "rootDir": "../..",
    "paths": {
      "@agenda-app/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../packages/shared/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
