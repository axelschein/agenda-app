PORT=3001
# Ruta relativa al directorio apps/api (o una ruta absoluta).
AGENDA_DB_PATH=../../data/agenda.sqlite
WEB_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Lista JSON de cuentas autorizadas. Dejala como [] si todavía no vas a configurar usuarios.
# Cada elemento es un objeto con esta forma:
# { "email": string, "role": "ADMIN" | "CLIENT" | "BARBER", "passwordHash": string }
# Para una cuenta profesional, agregá "role":"BARBER" y "peluqueroId" con el ID de peluquero cargado en la base.
# passwordHash debe ser el hash scrypt generado con:
# npm run auth:hash-password --workspace=@agenda-app/api
# Ejemplo de la estructura (reemplazá los valores y quitá el #):
# AUTH_USERS_JSON=[{"email":"admin@ejemplo.com","role":"ADMIN","passwordHash":"scrypt$<salt-base64url>$<hash-base64url>"}]
# Ejemplo de cuenta profesional: {"email":"peluquero@ejemplo.com","role":"BARBER","peluqueroId":"ana","passwordHash":"scrypt$<salt-base64url>$<hash-base64url>"}
AUTH_USERS_JSON=[]
